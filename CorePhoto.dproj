<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ProjectGuid>{A83F1142-4D90-449D-9F62-D8BD9D3AEF02}</ProjectGuid>
    <ProjectVersion>20.1</ProjectVersion>
    <FrameworkType>VCL</FrameworkType>
    <MainSource>CorePhoto.dpr</MainSource>
    <Base>True</Base>
    <Config Condition="'$(Config)'==''">Release</Config>
    <Platform Condition="'$(Platform)'==''">Win64</Platform>
    <TargetedPlatforms>3</TargetedPlatforms>
    <AppType>Application</AppType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Config)'=='Base'">
    <DCC_DcuOutput>.\dcu</DCC_DcuOutput>
    <DCC_ExeOutput>.\bin</DCC_ExeOutput>
    <DCC_UnitSearchPath>src\core;src\config;src\storage;src\database;src\camera;src\camera\adapters;src\imaging;src\validation;src\diagnostics;src\ui;src\ui\controls;$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
    <DCC_E>false</DCC_E>
    <DCC_N>false</DCC_N>
    <DCC_S>false</DCC_S>
    <DCC_F>false</DCC_F>
    <DCC_K>false</DCC_K>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Config)'=='Release'">
    <DCC_LocalDebugSymbols>false</DCC_LocalDebugSymbols>
    <DCC_Define>RELEASE;$(DCC_Define)</DCC_Define>
    <DCC_SymbolReferenceInfo>0</DCC_SymbolReferenceInfo>
    <DCC_DebugInformation>0</DCC_DebugInformation>
  </PropertyGroup>
  <ItemGroup>
    <DelphiCompile Include="CorePhoto.dpr">
      <MainSource>MainSource</MainSource>
    </DelphiCompile>
  </ItemGroup>
  <Import Project="$(BDS)\Bin\CodeGear.Delphi.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Delphi.Targets')"/>
</Project>
